# Server Port (Railway will automatically assign PORT in production)
PORT=5000

# JWT & Admin Security
JWT_SECRET=super_secret_gpdms_key_for_jwt_session_validation_2026
ADMIN_SECRET_CODE=MHSTORE@ADMIN2026
NOMAL_LOCATION=MHSTORE2026@

# --- AIVEN MYSQL DATABASE CONFIGURATION ---
# Option 1: Full Connection URI from Aiven (Recommended)
# DATABASE_URL=mysql://avnadmin:YOUR_PASSWORD@YOUR_AIVEN_HOST:YOUR_PORT/defaultdb?ssl-mode=REQUIRED

# Option 2: Individual Connection Parameters
MYSQL_HOST=your-mysql-instance.aivencloud.com
MYSQL_PORT=12345
MYSQL_USER=avnadmin
MYSQL_PASSWORD=your_aiven_password
MYSQL_DATABASE=defaultdb
MYSQL_SSL=true

# --- GMAIL / SMTP CONFIGURATION (Optional for OTP verification) ---
SMTP_SERVICE=gmail
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-google-app-password
